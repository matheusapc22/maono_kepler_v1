name = "maono-change-reconciliation"
main = "workers/change-reconciliation.js"
compatibility_date = "2026-09-01"
[triggers]
crons = ["*/5 * * * *"]
[vars]
MAONO_RUNTIME_ENV = "production"
MAONO_TICKET_CHANGES_ENABLED = "false"
MAONO_CHANGE_RECONCILIATION_ENABLED = "false"
MAONO_TICKET_SELECTIVE_ACCESS_ENABLED = "false"
MAONO_CHANGE_RECONCILIATION_ORGANIZATION_IDS = ""
MAONO_CHANGE_RECONCILIATION_ACTOR_ID = ""
[[d1_databases]]
binding = "DB"
database_name = "maono_maps"
database_id = "5bc4dc32-f3bd-4c92-bbd1-cbda63e467db"

# EXEMPLO SEGURO — Worker dedicado ao recovery de storage das organizações.
# A ativação em Production é um gate operacional separado da PRH-06.
# Substitua o database_id antes do deploy e configure os secrets do Dropbox
# com `wrangler secret put`.

name = "maono-organization-storage-recovery"
main = "workers/organization-storage-recovery.js"
compatibility_date = "2026-05-21"

[vars]
MAONO_STORAGE_RECOVERY_ENABLED = "false"
MAONO_STORAGE_RECOVERY_KILL_SWITCH = "false"
MAONO_STORAGE_RECOVERY_DRY_RUN = "true"
MAONO_STORAGE_RECOVERY_BATCH_SIZE = "10"
MAONO_STORAGE_RECOVERY_ERROR_BACKOFF_SECONDS = "900"
MAONO_STORAGE_RECOVERY_CLAIM_TTL_SECONDS = "120"

[[d1_databases]]
binding = "DB"
database_name = "maono_maps"
database_id = "COLE_AQUI_O_DATABASE_ID_DE_PRODUCAO"
migrations_dir = "migrations"

[triggers]
crons = ["*/15 * * * *"]

# Secrets obrigatórios:
# DROPBOX_APP_KEY
# DROPBOX_APP_SECRET
# DROPBOX_REFRESH_TOKEN
